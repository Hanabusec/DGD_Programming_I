List<string> todos = new List<string>();



while(true)
{
    Console.WriteLine("Hello!");
    Console.WriteLine("What do you want to d0?");
    Console.WriteLine("Press S to see all TODOs");
    Console.WriteLine("Press A to add a TODO");
    Console.WriteLine("Press R remove a TODO");
    Console.WriteLine("Press E to exit");

    string userChoice = Console.ReadLine();

    if (userChoice == "S")
    {
        Print("See all TODOs");
        //Console.WriteLine("Selected Option: See all TODOs");
    }
    else if (userChoice == "A")
    {
        Print("Add a TODOs");
        AddToDo();
        //Console.WriteLine("Selected Option: Add a TODOs");
    }
    else if (userChoice == "R")
    {
        Print("Remove a TODos");
        //Console.WriteLine("Selected Option: Remove a TODOs");
    }
    else if (userChoice == "E")
    {
        Print("Exit");
        //Console.WriteLine("Selected Option: Exit");
    }
    else
    {
        Console.WriteLine("Wrong input");
    }

}



void AddToDo()
{
    Console.WriteLine("Please enter your TODO");
    todos.Add(Console.ReadLine());
    Console.WriteLine("You have added a new to do: " + todos[0]);
}

